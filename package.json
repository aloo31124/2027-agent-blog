{
  "name": "aloo-github-pages-blog",
  "version": "1.0.0",
  "private": true,
  "description": "以 Eleventy 與 Node.js 建置、部署至 GitHub Pages 的個人部落格。",
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "start": "eleventy --serve",
    "test": "npm run build && node --test",
    "verify": "node scripts/verify-build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.2"
  },
  "overrides": {
    "@11ty/recursive-copy": "5.0.2"
  }
}
